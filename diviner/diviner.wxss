.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 200rpx;
}

.header {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #d4af37;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8a8a8a;
}

.menu-list {
  padding: 0 40rpx;
}

.menu-item {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.15);
}

.menu-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.menu-title {
  font-size: 30rpx;
  color: #d4af37;
  font-weight: bold;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.menu-desc {
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 1.4;
}

.menu-arrow {
  font-size: 48rpx;
  color: #666;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.compliance-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10, 10, 10, 0.98);
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
  z-index: 100;
}

.compliance-text {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 240rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4af37;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8a8a8a;
}

.content {
  padding: 0 40rpx;
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8a8a8a;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #666;
}

.spread-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.spread-item {
  background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.15);
}

.spread-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.spread-name {
  font-size: 30rpx;
  color: #d4af37;
  font-weight: bold;
}

.spread-cards {
  font-size: 24rpx;
  color: #8a8a8a;
  padding: 6rpx 16rpx;
  background: rgba(212, 175, 55, 0.1);
  border-radius: 20rpx;
}

.spread-positions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.position-tag {
  font-size: 22rpx;
  color: #e0e0e0;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
}

.spread-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.action-btn.edit {
  background: rgba(106, 13, 173, 0.2);
  color: #6a0dad;
}

.action-btn.delete {
  background: rgba(255, 107, 107, 0.2);
  color: #ff6b6b;
}

.footer {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
}

.create-btn {
  width: 100%;
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(106, 13, 173, 0.4);
}

.compliance-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10, 10, 10, 0.98);
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
  z-index: 100;
}

.compliance-text {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.detail-modal {
  width: 640rpx;
  max-height: 80vh;
  background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
  border-radius: 30rpx;
  overflow: hidden;
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  display: flex;
  flex-direction: column;
}

.detail-header {
  padding: 40rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.1);
}

.detail-name {
  font-size: 36rpx;
  color: #d4af37;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.detail-cards {
  font-size: 24rpx;
  color: #8a8a8a;
}

.detail-positions {
  flex: 1;
  padding: 30rpx 40rpx;
  overflow-y: auto;
  max-height: 50vh;
}

.position-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 25rpx;
}

.position-num {
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.position-info {
  flex: 1;
}

.position-name {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 8rpx;
}

.position-desc {
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 1.5;
}

.detail-footer {
  padding: 30rpx 40rpx 40rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
}

.close-btn {
  width: 100%;
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
}

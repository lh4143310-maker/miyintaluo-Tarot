.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4af37;
}

.form-section {
  padding: 0 40rpx;
}

.field {
  margin-bottom: 40rpx;
}

.field-label {
  font-size: 28rpx;
  color: #e0e0e0;
  margin-bottom: 20rpx;
}

.field-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 25rpx 30rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  box-sizing: border-box;
}

.card-count-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.count-option {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8a8a8a;
}

.count-option.active {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
}

.positions-section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.position-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.position-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.position-header {
  margin-bottom: 15rpx;
}

.position-num {
  font-size: 24rpx;
  color: #d4af37;
}

.position-input {
  width: 100%;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #e0e0e0;
  margin-bottom: 15rpx;
  box-sizing: border-box;
}

.position-input.desc {
  margin-bottom: 0;
  font-size: 24rpx;
  color: #8a8a8a;
}

.actions {
  display: flex;
  gap: 20rpx;
  padding: 40rpx;
}

.action-btn {
  flex: 1;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 30rpx;
  border: none;
}

.action-btn.cancel {
  background: transparent;
  color: #8a8a8a;
  border: 2rpx solid #666;
}

.action-btn.save {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
}

.action-btn.save[disabled] {
  opacity: 0.5;
  background: rgba(255, 255, 255, 0.1);
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 200rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.step-item {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: #8a8a8a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.step-item.active {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #d4af37;
  box-shadow: 0 0 20rpx rgba(106, 13, 173, 0.5);
}

.step-item.completed {
  background: #d4af37;
  color: #0a0a0a;
}

.step-line {
  width: 100rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.1);
}

.step-line.active {
  background: linear-gradient(90deg, #d4af37, rgba(255, 255, 255, 0.1));
}

.step-text {
  font-size: 28rpx;
  color: #d4af37;
}

.content {
  padding: 0 40rpx;
}

/* 状态提示 */
.status-hint {
  text-align: center;
  font-size: 32rpx;
  color: #e0e0e0;
  margin-bottom: 40rpx;
  min-height: 50rpx;
}

.status-hint.shuffling {
  color: #d4af37;
  animation: pulse 0.5s ease infinite alternate;
}

.status-hint.completed {
  color: #d4af37;
  font-weight: bold;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.6);
}

@keyframes pulse {
  from { opacity: 0.7; }
  to { opacity: 1; }
}

/* 牌堆容器 */
.cards-container {
  position: relative;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.deck-card {
  position: absolute;
  width: 140rpx;
  height: 210rpx;
  background: linear-gradient(135deg, #2d004d 0%, #1a0a2e 100%);
  border-radius: 14rpx;
  border: 3rpx solid rgba(212, 175, 55, 0.4);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
  transition: transform 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.deck-card .card-back {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-pattern {
  font-size: 48rpx;
  color: rgba(212, 175, 55, 0.6);
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.4);
}

/* 触摸提示 */
.touch-hint {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: float 2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.touch-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.touch-text {
  font-size: 26rpx;
  color: rgba(212, 175, 55, 0.8);
  background: rgba(0, 0, 0, 0.6);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

/* 洗牌进度 */
.shuffle-progress {
  margin-top: 40rpx;
  padding: 0 40rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6a0dad 0%, #d4af37 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 15rpx;
}

.progress-label {
  color: #8a8a8a;
}

.progress-value {
  color: #d4af37;
  font-weight: bold;
}

/* 操作提示 */
.operation-hints {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  align-items: center;
}

.hint-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.hint-dot {
  width: 8rpx;
  height: 8rpx;
  background: #d4af37;
  border-radius: 50%;
}

.hint-desc {
  font-size: 24rpx;
  color: #8a8a8a;
}

/* 底部 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx 50rpx;
  background: linear-gradient(180deg, transparent, rgba(10, 10, 10, 0.95));
}

.next-btn {
  width: 100%;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  transition: all 0.3s ease;
}

.next-btn.active {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(106, 13, 173, 0.4);
}

.next-btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: #666;
}

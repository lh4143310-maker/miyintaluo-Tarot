.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 300rpx;
}

/* 头部 */
.header {
  padding: 40rpx 40rpx 30rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #d4af37;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-bottom: 30rpx;
}

.progress {
  max-width: 500rpx;
  margin: 0 auto;
}

.progress-text {
  font-size: 28rpx;
  color: #e0e0e0;
  margin-bottom: 15rpx;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4af37, #f0d060);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 5x5 网格 */
.grid-container {
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  max-width: 700rpx;
  margin: 0 auto;
}

.grid-card {
  aspect-ratio: 2/3;
  position: relative;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.grid-card:active {
  transform: scale(0.95);
}

.grid-card.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.card-inner {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.card-back {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #2d004d 0%, #1a0a2e 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.4);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.card-pattern {
  width: 60%;
  height: 60%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, transparent 70%);
  border: 1rpx solid rgba(212, 175, 55, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pattern-star {
  font-size: 32rpx;
  color: #d4af37;
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.8);
}

.card-number {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: rgba(212, 175, 55, 0.6);
}

/* 选中状态 */
.grid-card.selected .card-inner {
  box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.6);
}

.grid-card.selected .card-back {
  border-color: #d4af37;
  background: linear-gradient(135deg, #3d0066 0%, #2a1040 100%);
}

.selected-mark {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #d4af37, #f0d060);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(212, 175, 55, 0.5);
  animation: markAppear 0.3s ease;
}

@keyframes markAppear {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

.mark-number {
  font-size: 24rpx;
  font-weight: bold;
  color: #1a0a2e;
}

/* 已选牌预览 */
.selected-preview {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.preview-title {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 20rpx;
  text-align: center;
}

.preview-list {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.preview-card {
  width: 100rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.preview-card.empty {
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed rgba(212, 175, 55, 0.3);
}

.preview-card.filled {
  background: linear-gradient(135deg, #2d004d 0%, #1a0a2e 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.2);
}

.preview-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4af37;
}

.preview-position {
  font-size: 20rpx;
  color: #8a8a8a;
  margin-top: 10rpx;
  text-align: center;
  padding: 0 5rpx;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx 50rpx;
  background: linear-gradient(180deg, transparent, rgba(10, 10, 10, 0.95));
}

.footer-hint {
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8a;
  margin-bottom: 20rpx;
}

.footer-hint.complete {
  color: #d4af37;
}

.footer-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.reset-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #e0e0e0;
}

.result-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #666;
}

.result-btn.active {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(106, 13, 173, 0.4);
}

.result-btn.disabled {
  opacity: 0.5;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 240rpx;
}

.header {
  padding: 40rpx;
}

.spread-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #d4af37;
  text-align: center;
  margin-bottom: 30rpx;
}

.question-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.question-label {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 10rpx;
}

.question-text {
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.6;
}

.cards-section,
.interpretation-section,
.actions-section {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
  border-left: 4rpx solid #d4af37;
}

.result-cards {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.result-card-item {
  background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.2);
}

.card-position-label {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 15rpx;
}

.result-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
}

.result-card.clickable {
  cursor: pointer;
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
}

.result-card.clickable:active {
  transform: scale(0.98);
  background: rgba(212, 175, 55, 0.1);
  border-color: rgba(212, 175, 55, 0.3);
}

.card-detail-hint {
  position: absolute;
  bottom: 10rpx;
  right: 15rpx;
  font-size: 20rpx;
  color: rgba(212, 175, 55, 0.6);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.result-card.clickable:hover .card-detail-hint,
.result-card.clickable:active .card-detail-hint {
  opacity: 1;
}

.result-card-image {
  width: 120rpx;
  height: 168rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 5rpx 20rpx rgba(212, 175, 55, 0.15);
}

.result-card-image .card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.result-card-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #2d004d 0%, #1a0a2e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
}

.result-placeholder-deco {
  font-size: 30rpx;
  color: rgba(212, 175, 55, 0.7);
  margin-bottom: 8rpx;
}

.result-placeholder-name {
  font-size: 20rpx;
  color: #d4af37;
  text-align: center;
  padding: 0 6rpx;
  line-height: 1.3;
}

.result-card-main {
  flex: 1;
  text-align: left;
}

.result-card-name {
  font-size: 32rpx;
  color: #d4af37;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.result-card-position {
  font-size: 24rpx;
  color: #4cd964;
}

.result-card-position.reversed {
  color: #ff6b6b;
}

.card-desc {
  font-size: 24rpx;
  color: #666;
}

.card-interpretations {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.card-interpretation {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.interpretation-header {
  margin-bottom: 15rpx;
}

.interpretation-name {
  font-size: 28rpx;
  color: #d4af37;
  font-weight: bold;
}

.interpretation-content {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.8;
}

/* AI 解读报告 */
.ai-report-section {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.ai-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  background: linear-gradient(90deg, rgba(106, 13, 173, 0.3), transparent);
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #d4af37;
}

.toggle-icon {
  font-size: 24rpx;
  color: #d4af37;
  transition: transform 0.3s ease;
}

.toggle-icon.open {
  transform: rotate(180deg);
}

.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(212, 175, 55, 0.2);
  border-top-color: #d4af37;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #d4af37;
}

.ai-report-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s ease;
}

.ai-report-content.show {
  max-height: 10000rpx;
}

.ai-report-text {
  background: linear-gradient(145deg, rgba(35, 12, 75, 0.6), rgba(25, 8, 55, 0.6));
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.8;
  white-space: pre-wrap;
}

.ai-report-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.placeholder-text {
  font-size: 28rpx;
  color: #8a8a8a;
  margin-bottom: 30rpx;
  text-align: center;
}

.retry-btn {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 进一步咨询 */
.consult-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
}

.consult-title {
  font-size: 32rpx;
  color: #d4af37;
  text-align: center;
  margin-bottom: 30rpx;
}

.consult-input-area {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.consult-input {
  width: 100%;
  height: 120rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.consult-btn {
  width: 100%;
  background: rgba(255, 255, 255, 0.1);
  color: #666;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
  transition: all 0.3s ease;
  pointer-events: auto;
  opacity: 1;
}

.consult-btn::after {
  border: none;
}

.consult-btn.active {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(106, 13, 173, 0.4);
}

.consult-btn.loading {
  opacity: 1;
  background: linear-gradient(135deg, #d4af37 0%, #b8960c 100%);
  color: #1a1a2e;
  font-weight: bold;
}

.consult-history {
  margin-top: 40rpx;
}

.history-title {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #d4af37;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.history-question {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.history-answer {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.6;
}

.answer-text {
  white-space: pre-wrap;
  word-wrap: break-word;
}

.actions-section {
  display: flex;
  justify-content: center;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  width: 100%;
  max-width: 400rpx;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 30rpx;
  border: none;
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(106, 13, 173, 0.4);
}

.compliance-footer {
  padding: 30rpx 40rpx 40rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
}

.compliance-text {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

/* ============================
   首页 - 深紫星空塔罗风格
   ============================ */

.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #0d0820 0%, #1a0a3e 35%, #2a0d5e 65%, #1a0a3e 85%, #0d0820 100%);
  padding-bottom: 200rpx;
  position: relative;
  overflow: hidden;
}

/* ——— 动态星座 Canvas ——— */
.constellation-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* ——— 背景装饰层 ——— */
.bg-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 1;
}

/* 闪烁星星 */
.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 10rpx 2rpx rgba(255,255,255,0.8);
  animation: twinkle 3s ease-in-out infinite;
}
.star:nth-child(1) { top: 8%; left: 15%; animation-delay: 0s; }
.star:nth-child(2) { top: 12%; right: 20%; width: 6rpx; height: 6rpx; animation-delay: 0.5s; }
.star:nth-child(3) { top: 18%; left: 8%; animation-delay: 1s; }
.star:nth-child(4) { top: 25%; right: 12%; animation-delay: 1.5s; }
.star:nth-child(5) { top: 5%; left: 45%; width: 5rpx; height: 5rpx; animation-delay: 2s; }
.star:nth-child(6) { top: 32%; left: 25%; animation-delay: 0.3s; }
.star:nth-child(7) { top: 15%; right: 35%; animation-delay: 0.8s; }
.star:nth-child(8) { top: 22%; left: 75%; width: 5rpx; height: 5rpx; animation-delay: 1.2s; }
.star:nth-child(9) { top: 45%; right: 8%; animation-delay: 1.8s; }
.star:nth-child(10) { top: 55%; left: 12%; animation-delay: 2.5s; }
.star:nth-child(11) { top: 65%; right: 25%; width: 4rpx; height: 4rpx; animation-delay: 0.2s; }
.star:nth-child(12) { top: 75%; left: 20%; animation-delay: 0.7s; }
.star:nth-child(13) { top: 85%; right: 15%; animation-delay: 1.3s; }
.star:nth-child(14) { top: 48%; left: 85%; animation-delay: 2.2s; }
.star:nth-child(15) { top: 38%; right: 45%; width: 3rpx; height: 3rpx; animation-delay: 1.6s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* 漂浮粒子 */
.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: radial-gradient(circle, rgba(212,175,55,0.8) 0%, transparent 70%);
  border-radius: 50%;
  animation: float 8s ease-in-out infinite;
}
.particle:nth-child(16) { top: 20%; left: 10%; animation-delay: 0s; }
.particle:nth-child(17) { top: 60%; left: 20%; animation-delay: 1s; }
.particle:nth-child(18) { top: 40%; left: 80%; animation-delay: 2s; }
.particle:nth-child(19) { top: 70%; left: 60%; animation-delay: 3s; }
.particle:nth-child(20) { top: 30%; left: 40%; animation-delay: 4s; }
.particle:nth-child(21) { top: 80%; left: 30%; animation-delay: 5s; }
.particle:nth-child(22) { top: 50%; left: 70%; animation-delay: 6s; }
.particle:nth-child(23) { top: 10%; left: 60%; animation-delay: 7s; }
.particle:nth-child(24) { top: 85%; left: 85%; animation-delay: 2.5s; }
.particle:nth-child(25) { top: 15%; left: 90%; animation-delay: 3.5s; }
.particle:nth-child(26) { top: 65%; left: 5%; animation-delay: 4.5s; }
.particle:nth-child(27) { top: 35%; left: 55%; animation-delay: 5.5s; }

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
  25% { transform: translateY(-20rpx) translateX(10rpx); opacity: 0.8; }
  50% { transform: translateY(-10rpx) translateX(-10rpx); opacity: 0.5; }
  75% { transform: translateY(-30rpx) translateX(5rpx); opacity: 0.7; }
}

/* 流星 */
.shooting-star {
  position: absolute;
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #fff, transparent);
  animation: shoot 3s linear infinite;
  opacity: 0;
}
.shooting-star:nth-child(28) { top: 10%; left: -100rpx; animation-delay: 0s; }
.shooting-star:nth-child(29) { top: 30%; left: -100rpx; animation-delay: 5s; }
.shooting-star:nth-child(30) { top: 50%; left: -100rpx; animation-delay: 8s; }

@keyframes shoot {
  0% { transform: translateX(0) rotate(-45deg); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { transform: translateX(800rpx) rotate(-45deg); opacity: 0; }
}

/* 旋转的塔罗符号 */
.tarot-symbol.rotate {
  animation: rotate 20s linear infinite;
}
.tarot-symbol.rotate:nth-of-type(1) { animation-delay: 0s; }
.tarot-symbol.rotate:nth-of-type(2) { animation-delay: -5s; }
.tarot-symbol.rotate:nth-of-type(3) { animation-delay: -10s; }
.tarot-symbol.rotate:nth-of-type(4) { animation-delay: -15s; }
.tarot-symbol.rotate:nth-of-type(5) { animation-delay: -8s; }

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 旋转魔法阵 */
.magic-circle.rotating {
  animation: rotate 30s linear infinite;
  border-style: dashed;
  border-color: rgba(212,175,55,0.2);
}

/* 光晕效果 */
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  animation: pulse 4s ease-in-out infinite;
}
.glow-1 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(106,13,173,0.3) 0%, transparent 70%);
  top: 20%;
  left: 10%;
  animation-delay: 0s;
}
.glow-2 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(212,175,55,0.2) 0%, transparent 70%);
  top: 50%;
  right: 5%;
  animation-delay: 2s;
}
.glow-3 {
  width: 250rpx;
  height: 250rpx;
  background: radial-gradient(circle, rgba(75,0,130,0.25) 0%, transparent 70%);
  bottom: 20%;
  left: 30%;
  animation-delay: 1s;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 0.8; }
}

/* 大星座图案 - 北斗七星 */
.constellation {
  position: absolute;
  top: 15%;
  right: 5%;
  width: 200rpx;
  height: 150rpx;
  opacity: 0.15;
}
.constellation-dot {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: #d4af37;
  border-radius: 50%;
  box-shadow: 0 0 15rpx #d4af37;
}
.constellation-line {
  position: absolute;
  height: 1rpx;
  background: linear-gradient(90deg, #d4af37, transparent);
  transform-origin: left center;
}

/* 月亮装饰 */
.moon {
  position: absolute;
  top: 60rpx;
  right: 60rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: transparent;
  box-shadow: -15rpx 5rpx 0 0 rgba(212, 175, 55, 0.15);
  opacity: 0.6;
}

/* 塔罗符号 */
.tarot-symbol {
  position: absolute;
  font-size: 120rpx;
  color: rgba(212, 175, 55, 0.03);
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.1);
}
.tarot-symbol:nth-of-type(1) { top: 20%; left: 5%; transform: rotate(-15deg); }
.tarot-symbol:nth-of-type(2) { top: 60%; right: 8%; transform: rotate(20deg); }
.tarot-symbol:nth-of-type(3) { bottom: 25%; left: 10%; transform: rotate(-10deg); }

/* 六芒星 */
.hexagram {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  opacity: 0.08;
}
.hexagram::before,
.hexagram::after {
  content: '✡';
  position: absolute;
  font-size: 100rpx;
  color: #d4af37;
  top: 0;
  left: 0;
}
.hexagram:nth-of-type(1) { top: 35%; left: 8%; }
.hexagram:nth-of-type(2) { bottom: 30%; right: 10%; transform: rotate(30deg); }

/* 魔法阵 */
.magic-circle {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(212, 175, 55, 0.12);
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%);
}
.magic-circle.outer {
  width: 560rpx;
  height: 560rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.1);
  box-shadow: 0 0 60rpx rgba(212, 175, 55, 0.04) inset;
}
.magic-circle.inner {
  width: 380rpx;
  height: 380rpx;
  border: 1rpx solid rgba(180, 120, 200, 0.15);
}

/* 魔法十字 */
.magic-cross {
  position: absolute;
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  height: 560rpx;
}
.magic-cross::before,
.magic-cross::after {
  content: '';
  position: absolute;
  background: rgba(212, 175, 55, 0.06);
}
.magic-cross::before {
  width: 1rpx;
  height: 100%;
  left: 50%;
}
.magic-cross::after {
  width: 100%;
  height: 1rpx;
  top: 50%;
}

/* 四角装饰 */
.corner-deco {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  opacity: 0.35;
}
.corner-deco.tl { top: 60rpx; left: 40rpx; border-top: 2rpx solid #d4af37; border-left: 2rpx solid #d4af37; }
.corner-deco.tr { top: 60rpx; right: 40rpx; border-top: 2rpx solid #d4af37; border-right: 2rpx solid #d4af37; }
.corner-deco.bl { bottom: 180rpx; left: 40rpx; border-bottom: 2rpx solid #d4af37; border-left: 2rpx solid #d4af37; }
.corner-deco.br { bottom: 180rpx; right: 40rpx; border-bottom: 2rpx solid #d4af37; border-right: 2rpx solid #d4af37; }

/* ——— 头部 ——— */
.header {
  padding: 100rpx 0 50rpx;
  text-align: center;
  position: relative;
  z-index: 10;
}

.tarot-title {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-deco {
  font-size: 22rpx;
  color: #d4af37;
  opacity: 0.7;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 80rpx;
  font-weight: bold;
  color: #f0d060;
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.8), 0 0 60rpx rgba(212, 175, 55, 0.3), 0 4rpx 20rpx rgba(0,0,0,0.6);
  margin-bottom: 14rpx;
  font-family: 'Times New Roman', serif;
  letter-spacing: 16rpx;
}

.title-subtext {
  font-size: 24rpx;
  color: #c0a8e8;
  opacity: 0.85;
  letter-spacing: 5rpx;
  margin-bottom: 24rpx;
}

.title-line {
  width: 200rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
  opacity: 0.5;
}

/* ——— 内容区 ——— */
.content {
  padding: 0 40rpx;
  position: relative;
  z-index: 10;
}

.main-buttons {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.button-wrapper {
  width: 100%;
}

/* 主按钮 - 深紫色+金边 */
.main-button {
  background: linear-gradient(145deg, rgba(45,16,96,0.85) 0%, rgba(61,24,120,0.9) 50%, rgba(45,16,96,0.85) 100%);
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(100, 40, 180, 0.4), 0 0 0 1rpx rgba(212, 175, 55, 0.15) inset;
  backdrop-filter: blur(10rpx);
}

.main-button::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.6), transparent);
}

.btn-glow-top {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 80rpx;
  background: radial-gradient(ellipse, rgba(212, 175, 55, 0.25), transparent);
  pointer-events: none;
}

/* 次要按钮 - 深紫色+金边 */
.secondary-button {
  background: linear-gradient(145deg, rgba(37,13,80,0.85) 0%, rgba(53,21,112,0.9) 50%, rgba(37,13,80,0.85) 100%);
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 44rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(100, 40, 180, 0.4), 0 0 0 1rpx rgba(212, 175, 55, 0.15) inset;
  backdrop-filter: blur(10rpx);
}

.secondary-button::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.6), transparent);
}

/* 按钮图标包裹 */
.button-icon-wrap {
  margin-bottom: 18rpx;
}

.btn-hex {
  font-size: 60rpx;
  color: #d4af37;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.8);
}

.button-text {
  font-size: 38rpx;
  font-weight: bold;
  color: #f0d060;
  margin-bottom: 10rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 10rpx rgba(212, 175, 55, 0.4);
  animation: textShine 2s ease-in-out infinite;
}

@keyframes textShine {
  0%, 100% {
    text-shadow: 0 2rpx 10rpx rgba(212, 175, 55, 0.4);
    opacity: 0.9;
  }
  50% {
    text-shadow: 0 2rpx 20rpx rgba(212, 175, 55, 0.8), 0 0 30rpx rgba(212, 175, 55, 0.6);
    opacity: 1;
  }
}

.button-subtext {
  font-size: 24rpx;
  color: #c0a8e8;
  opacity: 0.85;
  letter-spacing: 1rpx;
}

.btn-border-deco {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), transparent);
}

/* ——— 占卜师入口 ——— */
.diviner-entry {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 28rpx 30rpx;
  background: rgba(30, 10, 60, 0.4);
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  border-radius: 50rpx;
  margin-top: 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(100, 40, 180, 0.2);
  backdrop-filter: blur(8rpx);
}

.diviner-line-l,
.diviner-line-r {
  font-size: 18rpx;
  color: rgba(212, 175, 55, 0.35);
  letter-spacing: -2rpx;
  flex-shrink: 0;
  width: 80rpx;
  text-align: center;
}

.diviner-text {
  font-size: 26rpx;
  color: #c0a8e8;
  margin: 0 16rpx;
  letter-spacing: 2rpx;
}

.diviner-arrow {
  font-size: 34rpx;
  color: #d4af37;
  opacity: 0.8;
  margin: 0 8rpx;
  flex-shrink: 0;
}

/* ——— 底部合规 ——— */
.compliance-footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(8, 4, 20, 0.97);
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.12);
  z-index: 100;
}

.compliance-text {
  font-size: 20rpx;
  color: #8070a0;
  text-align: center;
  line-height: 1.6;
}

/* ——— 弹窗 ——— */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 80%;
  background: linear-gradient(145deg, #1a0a3e, #2a0d5e);
  border-radius: 20rpx;
  border: 2rpx solid #d4af37;
  padding: 50rpx 40rpx;
  box-shadow: 0 20rpx 80rpx rgba(100, 40, 180, 0.5), 0 0 0 1rpx rgba(212, 175, 55, 0.1) inset;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #f0d060;
  text-align: center;
  margin-bottom: 30rpx;
  letter-spacing: 3rpx;
  text-shadow: 0 0 15rpx rgba(212, 175, 55, 0.5);
}

.modal-body { margin-bottom: 30rpx; }

.modal-text {
  font-size: 26rpx;
  color: #c0a8e8;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.modal-btn {
  background: linear-gradient(135deg, #2d1060, #3d1878);
  color: #f0d060;
  border: 2rpx solid #d4af37;
  border-radius: 50rpx;
  padding: 20rpx 80rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 20rpx rgba(212, 175, 55, 0.2);
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #1a0a2e 100%);
  padding-bottom: 200rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #d4af37;
  margin-bottom: 10rpx;
}

.date {
  font-size: 28rpx;
  color: #8a8a8a;
}

.draw-area {
  padding: 40rpx;
}

.draw-hint {
  text-align: center;
  font-size: 28rpx;
  color: #e0e0e0;
  margin-bottom: 60rpx;
}

.card-deck {
  position: relative;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.deck-card {
  position: absolute;
  width: 180rpx;
  height: 270rpx;
  background: linear-gradient(135deg, #2d004d 0%, #1a0a2e 100%);
  border-radius: 18rpx;
  border: 3rpx solid rgba(212, 175, 55, 0.4);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.5);
  transition: transform 0.3s ease;
}

/* 洗牌动画 */
.deck-card.shuffling {
  animation: shuffle 0.5s ease-in-out infinite;
}

@keyframes shuffle {
  0%, 100% { 
    transform: translateX(0) rotate(0deg); 
  }
  25% { 
    transform: translateX(-30rpx) rotate(-5deg); 
  }
  50% { 
    transform: translateX(0) rotate(0deg); 
  }
  75% { 
    transform: translateX(30rpx) rotate(5deg); 
  }
}

.deck-label.hidden {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.deck-label {
  position: absolute;
  margin-top: 350rpx;
  font-size: 28rpx;
  color: #d4af37;
}

.result-area {
  padding: 0 40rpx;
}

.result-card {
  background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
  border-radius: 30rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 10rpx 30rpx rgba(212, 175, 55, 0.15);
  display: flex;
  align-items: center;
  gap: 30rpx;
  opacity: 1;
  transform: perspective(1000rpx) rotateY(0deg);
  transition: all 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.result-card.flip-in {
  opacity: 1;
  transform: perspective(1000rpx) rotateY(0deg);
}

/* 卡牌图片揭示动画 */
.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transform: scale(1);
  transition: all 0.6s ease 0.3s;
}

.card-img.reveal {
  opacity: 1;
  transform: scale(1);
}

/* 逆位旋转 */
.card-img.rotate {
  transform: scale(1) rotate(180deg);
}

.card-image {
  width: 160rpx;
  height: 224rpx;
  flex-shrink: 0;
  border-radius: 15rpx;
  overflow: hidden;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 5rpx 20rpx rgba(212, 175, 55, 0.15);
}



.card-main {
  flex: 1;
  text-align: left;
}

.card-name {
  font-size: 40rpx;
  color: #d4af37;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.card-en {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 20rpx;
}

.card-position {
  display: inline-block;
  padding: 10rpx 30rpx;
  background: rgba(76, 217, 100, 0.2);
  color: #4cd964;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.card-position.reversed {
  background: rgba(255, 107, 107, 0.2);
  color: #ff6b6b;
}

.meaning-section,
.interpretation-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 4rpx solid #d4af37;
}

.meaning-text,
.interpretation-text {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.8;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

/* AI 深度解读 */
.ai-report-section {
  margin-bottom: 40rpx;
}

.ai-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  background: linear-gradient(90deg, rgba(106, 13, 173, 0.3), transparent);
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #d4af37;
}

.toggle-icon {
  font-size: 24rpx;
  color: #d4af37;
  transition: transform 0.3s ease;
}

.toggle-icon.open {
  transform: rotate(180deg);
}

.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(212, 175, 55, 0.2);
  border-top-color: #d4af37;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #d4af37;
}

.ai-report-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s ease;
}

.ai-report-content.show {
  max-height: 8000rpx;
}

.ai-report-text {
  background: linear-gradient(145deg, rgba(35, 12, 75, 0.6), rgba(25, 8, 55, 0.6));
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.8;
  white-space: pre-wrap;
}

.ai-report-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.placeholder-text {
  font-size: 26rpx;
  color: #8a8a8a;
}

/* 进一步咨询 */
.consult-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
}

.consult-title {
  font-size: 32rpx;
  color: #d4af37;
  text-align: center;
  margin-bottom: 30rpx;
}

.consult-input-area {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.consult-input {
  width: 100%;
  height: 120rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.consult-btn {
  width: 100%;
  background: rgba(255, 255, 255, 0.1);
  color: #666;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 30rpx;
  transition: all 0.3s ease;
  pointer-events: auto;
  opacity: 1;
}

.consult-btn::after {
  border: none;
}

.consult-btn.active {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(106, 13, 173, 0.4);
}

.consult-btn.loading {
  opacity: 1;
  background: linear-gradient(135deg, #d4af37 0%, #b8960c 100%);
  color: #1a1a2e;
  font-weight: bold;
}

.consult-history {
  margin-top: 40rpx;
}

.history-title {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #d4af37;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.history-question {
  font-size: 28rpx;
  color: #d4af37;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.history-answer {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.6;
}

.answer-text {
  white-space: pre-wrap;
  word-wrap: break-word;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 30rpx;
  border: none;
}

.history-btn {
  background: rgba(26, 10, 46, 0.8);
  color: #d4af37;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.3);
}

.retry-btn {
  background: linear-gradient(135deg, rgba(45, 16, 96, 0.4), rgba(26, 10, 46, 0.6)) !important;
  color: #6a5a8a !important;
  border: 2rpx solid rgba(212, 175, 55, 0.2) !important;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  position: relative;
  overflow: hidden;
}

.retry-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.2), transparent);
}

.retry-btn[disabled] {
  background: linear-gradient(135deg, rgba(35, 12, 75, 0.3), rgba(20, 8, 45, 0.5)) !important;
  color: #5a4a7a !important;
  border: 2rpx solid rgba(212, 175, 55, 0.15) !important;
}

/* 覆盖微信默认按钮样式 */
button.retry-btn::after {
  border: none;
}

.compliance-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10, 10, 10, 0.98);
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
  z-index: 100;
}

.compliance-text {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

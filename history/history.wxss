/* ============================
   历史记录页 - 深紫星空塔罗风格
   ============================ */

.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #0d0820 0%, #1a0a3e 35%, #16082e 65%, #0d0820 100%);
  padding-bottom: 200rpx;
  position: relative;
  overflow: hidden;
}

/* ——— 动态星座 Canvas ——— */
.constellation-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* ——— 背景装饰 ——— */
.bg-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 1;
}

/* 闪烁星星 */
.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 10rpx 2rpx rgba(255,255,255,0.8);
  animation: twinkle 3s ease-in-out infinite;
}
.star:nth-child(1) { top: 5%; left: 10%; animation-delay: 0s; }
.star:nth-child(2) { top: 10%; right: 15%; width: 6rpx; height: 6rpx; animation-delay: 0.5s; }
.star:nth-child(3) { top: 15%; left: 20%; animation-delay: 1s; }
.star:nth-child(4) { top: 20%; right: 25%; animation-delay: 1.5s; }
.star:nth-child(5) { top: 8%; left: 50%; width: 5rpx; height: 5rpx; animation-delay: 2s; }
.star:nth-child(6) { top: 30%; left: 5%; animation-delay: 0.3s; }
.star:nth-child(7) { top: 12%; right: 40%; animation-delay: 0.8s; }
.star:nth-child(8) { top: 25%; left: 80%; width: 5rpx; height: 5rpx; animation-delay: 1.2s; }
.star:nth-child(9) { top: 40%; right: 10%; animation-delay: 1.8s; }
.star:nth-child(10) { top: 50%; left: 15%; animation-delay: 2.5s; }
.star:nth-child(11) { top: 60%; right: 20%; width: 4rpx; height: 4rpx; animation-delay: 0.2s; }
.star:nth-child(12) { top: 70%; left: 25%; animation-delay: 0.7s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* 漂浮粒子 */
.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: radial-gradient(circle, rgba(212,175,55,0.8) 0%, transparent 70%);
  border-radius: 50%;
  animation: float 8s ease-in-out infinite;
}
.particle:nth-child(13) { top: 20%; left: 10%; animation-delay: 0s; }
.particle:nth-child(14) { top: 60%; left: 20%; animation-delay: 1s; }
.particle:nth-child(15) { top: 40%; left: 80%; animation-delay: 2s; }
.particle:nth-child(16) { top: 70%; left: 60%; animation-delay: 3s; }
.particle:nth-child(17) { top: 30%; left: 40%; animation-delay: 4s; }
.particle:nth-child(18) { top: 80%; left: 30%; animation-delay: 5s; }
.particle:nth-child(19) { top: 50%; left: 70%; animation-delay: 6s; }
.particle:nth-child(20) { top: 10%; left: 60%; animation-delay: 7s; }
.particle:nth-child(21) { top: 85%; left: 85%; animation-delay: 2.5s; }

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
  25% { transform: translateY(-20rpx) translateX(10rpx); opacity: 0.8; }
  50% { transform: translateY(-10rpx) translateX(-10rpx); opacity: 0.5; }
  75% { transform: translateY(-30rpx) translateX(5rpx); opacity: 0.7; }
}

/* 流星 */
.shooting-star {
  position: absolute;
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #fff, transparent);
  animation: shoot 3s linear infinite;
  opacity: 0;
}
.shooting-star:nth-child(22) { top: 10%; left: -100rpx; animation-delay: 0s; }
.shooting-star:nth-child(23) { top: 40%; left: -100rpx; animation-delay: 6s; }

@keyframes shoot {
  0% { transform: translateX(0) rotate(-45deg); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { transform: translateX(800rpx) rotate(-45deg); opacity: 0; }
}

/* 旋转的塔罗符号 */
.tarot-symbol.rotate {
  animation: rotate 20s linear infinite;
}
.tarot-symbol.rotate:nth-of-type(1) { animation-delay: 0s; }
.tarot-symbol.rotate:nth-of-type(2) { animation-delay: -7s; }
.tarot-symbol.rotate:nth-of-type(3) { animation-delay: -14s; }

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 旋转魔法阵 */
.magic-circle.rotating {
  animation: rotate 30s linear infinite;
  border-style: dashed;
  border-color: rgba(212,175,55,0.2);
}

/* 光晕效果 */
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  animation: pulse 4s ease-in-out infinite;
}
.glow-1 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(106,13,173,0.3) 0%, transparent 70%);
  top: 25%;
  left: 5%;
  animation-delay: 0s;
}
.glow-2 {
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, rgba(212,175,55,0.2) 0%, transparent 70%);
  bottom: 15%;
  right: 10%;
  animation-delay: 2s;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 0.8; }
}

/* 月亮装饰 */
.moon {
  position: absolute;
  top: 80rpx;
  right: 50rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: transparent;
  box-shadow: -12rpx 4rpx 0 0 rgba(212, 175, 55, 0.12);
  opacity: 0.5;
}

/* 塔罗符号 */
.tarot-symbol {
  position: absolute;
  font-size: 100rpx;
  color: rgba(212, 175, 55, 0.04);
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.08);
}
.tarot-symbol:nth-of-type(1) { top: 15%; left: 8%; transform: rotate(-10deg); }
.tarot-symbol:nth-of-type(2) { top: 55%; right: 5%; transform: rotate(15deg); }

/* 六芒星 */
.hexagram {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.06;
}
.hexagram::before {
  content: '✡';
  position: absolute;
  font-size: 80rpx;
  color: #d4af37;
  top: 0;
  left: 0;
}
.hexagram:nth-of-type(1) { top: 40%; left: 5%; }
.hexagram:nth-of-type(2) { bottom: 35%; right: 8%; transform: rotate(25deg); }

.magic-circle {
  position: absolute;
  border-radius: 50%;
  left: 50%;
  top: 25%;
  transform: translate(-50%, -50%);
}
.magic-circle.outer {
  width: 500rpx;
  height: 500rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.07);
}
.magic-circle.inner {
  width: 320rpx;
  height: 320rpx;
  border: 1rpx solid rgba(180, 120, 200, 0.1);
}

.corner-deco {
  position: absolute;
  width: 50rpx;
  height: 50rpx;
  opacity: 0.3;
}
.corner-deco.tl { top: 50rpx; left: 30rpx; border-top: 2rpx solid #d4af37; border-left: 2rpx solid #d4af37; }
.corner-deco.tr { top: 50rpx; right: 30rpx; border-top: 2rpx solid #d4af37; border-right: 2rpx solid #d4af37; }

/* ——— 头部 ——— */
.header {
  padding: 60rpx 0 30rpx;
  text-align: center;
  position: relative;
  z-index: 10;
}

.title-deco {
  font-size: 20rpx;
  color: #d4af37;
  opacity: 0.6;
  letter-spacing: 8rpx;
  margin-bottom: 10rpx;
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #f0d060;
  margin-bottom: 24rpx;
  text-shadow: 0 0 25rpx rgba(212, 175, 55, 0.7), 0 4rpx 15rpx rgba(0,0,0,0.5);
  letter-spacing: 6rpx;
  font-family: 'Times New Roman', serif;
}

/* ——— 标签栏 ——— */
.tabs {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 10rpx;
  padding: 0 40rpx;
}

.tab-item {
  font-size: 26rpx;
  color: #9080c0;
  padding: 14rpx 36rpx;
  border-radius: 50rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  background: rgba(20, 8, 50, 0.5);
  letter-spacing: 1rpx;
}

.tab-item.active {
  color: #f0d060;
  background: linear-gradient(135deg, #2d1060, #3d1878);
  border: 1rpx solid rgba(212, 175, 55, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(100, 40, 180, 0.3);
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.4);
}

/* ——— 内容 ——— */
.content {
  padding: 20rpx 40rpx 0;
  position: relative;
  z-index: 10;
}

.login-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(30, 10, 60, 0.7);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 15rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 30rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #9080c0;
}

.tip-btn {
  background: linear-gradient(135deg, #2d1060, #3d1878);
  color: #f0d060;
  border: 1rpx solid #d4af37;
  border-radius: 50rpx;
  padding: 14rpx 36rpx;
  font-size: 24rpx;
}

/* ——— 空状态 ——— */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
  color: #d4af37;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.5);
}

.empty-text {
  font-size: 30rpx;
  color: #9080c0;
  letter-spacing: 2rpx;
}

/* ——— 历史列表 ——— */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(35, 12, 75, 0.9), rgba(25, 8, 55, 0.9));
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(80, 20, 160, 0.25), 0 0 0 1rpx rgba(212, 175, 55, 0.05) inset;
  position: relative;
  overflow: hidden;
}

.history-item::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), transparent);
}

.item-main {
  flex: 1;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.item-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #f0d060;
  letter-spacing: 2rpx;
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.3);
}

.item-time {
  font-size: 22rpx;
  color: #7060a0;
}

.item-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-question {
  font-size: 24rpx;
  color: #c0a8e8;
  line-height: 1.5;
}

.item-spread {
  font-size: 22rpx;
  color: #9080c0;
}

.item-cards {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
}

.cards-label {
  font-size: 20rpx;
  color: #7060a0;
}

.cards-value {
  font-size: 24rpx;
  color: #d4af37;
  line-height: 1.4;
  font-weight: 500;
}

.item-delete {
  margin-left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(180, 40, 40, 0.15);
  border: 1rpx solid rgba(200, 60, 60, 0.2);
}

.delete-icon {
  font-size: 28rpx;
  color: #c06060;
  opacity: 0.8;
}

/* ——— 底部合规 ——— */
.compliance-footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(8, 4, 20, 0.97);
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
  z-index: 100;
}

.compliance-text {
  font-size: 20rpx;
  color: #6050a0;
  text-align: center;
  line-height: 1.6;
}

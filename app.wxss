page {
  background-color: transparent;
  color: #e0e0e0;
  font-family: serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  min-height: 100vh;
}

/* 常用元素字体设置 */
view, text, input, button {
  font-family: serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 30rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #6a0dad 0%, #4b0082 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 50rpx;
  font-size: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(106, 13, 173, 0.4);
}

.btn-secondary {
  background: transparent;
  color: #d4af37;
  border: 2rpx solid #d4af37;
  border-radius: 50rpx;
  padding: 23rpx 48rpx;
  font-size: 32rpx;
}

.card {
  background: linear-gradient(145deg, #1a1a1a 0%, #0f0f0f 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.title {
  color: #d4af37;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.text-gold {
  color: #d4af37;
}

.text-muted {
  color: #8a8a8a;
}

.compliance-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10, 10, 10, 0.95);
  padding: 20rpx 30rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
  z-index: 100;
}

.compliance-text {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

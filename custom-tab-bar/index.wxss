.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #0a0a0a;
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 9999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.tab-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  color: #8a8a8a;
}

.tab-text {
  font-size: 28rpx;
  color: #8a8a8a;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: #d4af37;
}
